APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://codereviewer:codereviewer@postgres:5432/codereviewer
# Untuk deployment dengan Docker secrets, isi DATABASE_* dan *_FILE sebagai pengganti URL.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=codereviewer
DATABASE_USERNAME=codereviewer
DATABASE_PASSWORD=
DATABASE_PASSWORD_FILE=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=codereviewer-password
NEO4J_PASSWORD_FILE=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_PRIVATE_KEY_BASE64_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET_FILE=
GITHUB_API_URL=https://api.github.com

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.7-flash
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=1

RETRIEVAL_MODE=graph
GRAPH_MAX_HOPS=2
GRAPH_MAX_NODES_PER_SYMBOL=12
CONTEXT_TOKEN_BUDGET=10000
MAX_REPOSITORY_FILES=500
MAX_SOURCE_FILE_BYTES=250000
MAX_CHANGED_FILES=30
MAX_CHANGED_LINES=2000
MAX_FINDINGS=10
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_JOB_TIMEOUT_SECONDS=90
DRY_RUN=false
